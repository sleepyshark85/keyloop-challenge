{
  "name": "keyloop-service-scheduler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Keyloop technical assessment \u2014 Scenario A, Unified Service Scheduler (backend)",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0 <25",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "log": "node tools/team-log/query.mjs",
    "log:append": "node tools/team-log/append.mjs",
    "board": "node tools/board/generate.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "db:migrate": "node-pg-migrate -m src/persistence/migrations -t pgmigrations up",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:nodb": "vitest run --project nodb",
    "test:tools": "node tools/test/guard-paths.test.mjs && node tools/test/docs-build.test.mjs && node tools/test/capture-prompt.test.mjs && node tools/test/report-capture.test.mjs && node tools/test/red-proof.test.mjs && node tools/test/lint-arch.test.mjs && node tools/test/collect-ci.test.mjs && node tools/test/defects.test.mjs && node tools/test/slice-check.test.mjs",
    "slice:check": "node tools/slice/check.mjs",
    "docs:build": "node tools/docs/build.mjs",
    "docs:check": "node tools/docs/build.mjs --check",
    "log:audit": "node tools/team-log/audit.mjs",
    "diagram:export": "node tools/docs/export-diagram.mjs",
    "lint:arch": "node tools/ci/lint-arch.mjs src tests",
    "graph:modules": "depcruise src --config .dependency-cruiser.js --output-type mermaid",
    "status": "node tools/status/generate.mjs",
    "test:docs": "node tools/test/docs-build.test.mjs",
    "defects": "node tools/defects/generate.mjs",
    "defects:check": "node tools/defects/generate.mjs --check",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.2.0",
    "node-pg-migrate": "9.0.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pino": "10.3.1"
  }
}
