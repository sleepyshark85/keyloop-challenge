{
  "openapi": "3.1.0",
  "info": {
    "title": "Keyloop Unified Service Scheduler",
    "description": "Service-appointment scheduling for automotive dealerships. No authentication (ADR-0002); a candidate list is advisory only — every write is adjudicated by PostgreSQL (CLAUDE.md §2.1).",
    "version": "1.0.0"
  },
  "components": {
    "responses": {
      "RouteNotFound": {
        "description": "No route matches the requested method and path.",
        "content": {
          "application/problem+json": {
            "schema": {
              "additionalProperties": false,
              "description": "RFC 9457 problem detail.",
              "type": "object",
              "required": [
                "type",
                "title",
                "status"
              ],
              "properties": {
                "type": {
                  "anyOf": [
                    {
                      "const": "/problems/route-not-found",
                      "type": "string"
                    }
                  ]
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                },
                "resource": {
                  "anyOf": [
                    {
                      "const": "bay",
                      "type": "string"
                    },
                    {
                      "const": "technician",
                      "type": "string"
                    }
                  ]
                },
                "reference": {
                  "type": "string"
                },
                "opensAt": {
                  "type": "string"
                },
                "closesAt": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Internal": {
        "description": "The request could not be completed; the failure has been logged.",
        "content": {
          "application/problem+json": {
            "schema": {
              "additionalProperties": false,
              "description": "RFC 9457 problem detail.",
              "type": "object",
              "required": [
                "type",
                "title",
                "status"
              ],
              "properties": {
                "type": {
                  "anyOf": [
                    {
                      "const": "/problems/internal",
                      "type": "string"
                    }
                  ]
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                },
                "resource": {
                  "anyOf": [
                    {
                      "const": "bay",
                      "type": "string"
                    },
                    {
                      "const": "technician",
                      "type": "string"
                    }
