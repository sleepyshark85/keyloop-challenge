        "responses": {
          "200": {
            "description": "The service and its database are both up.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "description": "The service and its database are both up.",
                  "type": "object",
                  "required": [
                    "status",
                    "checks"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
