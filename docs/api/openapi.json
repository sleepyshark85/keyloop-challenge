    "/appointments": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "A booking request. There is deliberately no end time: the interval is derived from the service type's duration (AC-6).",
                "type": "object",
                "required": [
                  "dealershipId",
                  "customerId",
                  "vehicleId",
                  "serviceTypeId",
                  "startsAt"
                ],
                "properties": {
                  "dealershipId": {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                    "type": "string"
                  },
                  "customerId": {
